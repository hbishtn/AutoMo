# Copy this file to ".env" and fill in what you want.
# Everything here is OPTIONAL. Phase 1 works with nothing filled in.

# --- Speech-to-text ---
# Free key from https://console.groq.com/keys (no credit card required).
# Leave blank to automatically use the free Google Web Speech fallback instead.
GROQ_API_KEY=freshtest999mytest789

# Groq model used for transcription if GROQ_API_KEY is set.
GROQ_STT_MODEL=

# --- Optional: command-understanding LLM (not used in Phase 1; reserved) ---
GROQ_LLM_MODEL=

# --- Optional: alternative AI backend (reserved for later phases) ---
NVIDIA_NIM_API_KEY=

# --- Agent behavior ---
# Language hint for STT: "hi" (Hindi), "en" (English), or leave blank for auto-detect.
AGENT_LANGUAGE_HINT=

# Seconds of audio to record per listen cycle.
LISTEN_DURATION_SECONDS=4

# Voice speaking rate (words per minute) for pyttsx3.
TTS_RATE=175
